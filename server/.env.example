PORT=5000
CLIENT_ORIGIN=http://localhost:5173
DB_USER=BANK_APP
DB_PASSWORD=replace_with_oracle_cloud_user_password
DB_CONNECT_STRING=<copy-the-current-oracle-freesql-schema-connect-string>
DB_POOL_MIN=1
DB_POOL_MAX=5
SESSION_SECRET=replace_with_at_least_32_random_characters
# Optional for Autonomous Database wallet/mTLS connections:
# DB_WALLET_DIR=<absolute-path-to-a-local-wallet-directory>
# DB_WALLET_PASSWORD=replace_with_wallet_password
